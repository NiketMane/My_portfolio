# Portfolio Backend Environment Variables

PORT=5000

# Recipient email where contact form submissions will be sent
RECIPIENT_EMAIL=developer.niket@gmail.com

# SMTP Server Settings (Nodemailer)
# For Gmail: host=smtp.gmail.com, port=587, use App Password for SMTP_PASS
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=developer.niket@gmail.com
SMTP_PASS=your_app_password
